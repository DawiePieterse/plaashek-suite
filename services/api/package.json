{
  "name": "@plaashek/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "hek-api + sync-api",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test $(find src -name '*.test.ts')",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@plaashek/schema": "workspace:*",
    "@plaashek/tickets": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
