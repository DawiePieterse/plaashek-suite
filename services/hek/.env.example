# Copy to .env and fill in. Never commit .env.
APP_NAME=Plaashek
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=single
LOG_LEVEL=debug

# The central database: organisations, farms, licences, Plaashek staff, the login directory.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plaashek
DB_USERNAME=hek
DB_PASSWORD=hek

# Farm databases are named <prefix>f_<farm slug>. On Afrihost this is the cPanel prefix
# (bowlsbg5n9w0_) and the databases are made in cPanel's Database Wizard, so auto-create stays off.
FARM_DB_PREFIX=plaashek_
FARM_DB_AUTO_CREATE=true

# Device tickets and office sessions: php artisan plaashek:keys fills these in.
TICKET_SIGNING_KEY_JWK=
STAFF_SESSION_SECRET=
MANAGEMENT_SESSION_SECRET=

# One per app: admin 5173, field 5174, owner 5175, management 5177.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5177
# Where the pairing QR points. Set to the field app's dev server to scan a printed QR locally.
FIELD_APP_URL=http://localhost:5174

CACHE_STORE=file
