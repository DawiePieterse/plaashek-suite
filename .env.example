# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/plaashek_dev

# services/api — generate with: node services/api/scripts/generate-signing-key.mjs
TICKET_SIGNING_KEY_JWK=
STAFF_SESSION_SECRET=
MANAGEMENT_SESSION_SECRET=
PORT=8080
# One per dev server: admin 5173, field 5174, owner 5175, management 5177.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5177
# Optional — defaults to https://app.plaashek.co.za. Set to the field app's
# dev server (e.g. http://localhost:5174) to actually open/scan a printed QR locally.
FIELD_APP_URL=

MEDIA_BUCKET_URL=
MEDIA_BUCKET_KEY=
MEDIA_BUCKET_SECRET=
WHATSAPP_API_TOKEN=
